# Copie para .env e ajuste
PORT=3333
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Deixe em branco se seu MySQL local nao tiver senha de root
# (padrao ao instalar via "brew install mysql" no Mac)
DB_PASSWORD=sua_senha
DB_NAME=solus_frete
JWT_SECRET=troque-esta-chave-em-producao
COMISSAO_PLATAFORMA=0.20
# No prototipo, o parceiro escolhido aceita o pedido sozinho depois deste tempo
ACEITE_AUTOMATICO_SEGUNDOS=8
